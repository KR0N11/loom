# --- LLM provider ---
LOOM_LLM_PROVIDER=anthropic            # anthropic | bedrock | claude_code (dev: uses `claude -p` on your subscription)
ANTHROPIC_API_KEY=sk-ant-...
LOOM_LLM_MODEL=claude-sonnet-5
# Bedrock switch (only used when LOOM_LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
LOOM_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-v1:0

# --- Storage ---
LOOM_DUCKDB_PATH=data/duckdb/loom.duckdb
LOOM_VECTOR_BACKEND=duckdb             # pgvector | duckdb (local fallback)
LOOM_PG_DSN=postgresql://loom:loom@localhost:5432/loom
LOOM_CHECKPOINT_PATH=data/checkpoints/loom.sqlite

# --- Sandbox ---
LOOM_SANDBOX_BACKEND=subprocess        # docker | subprocess | lambda
LOOM_SANDBOX_TIMEOUT_S=30
LOOM_SANDBOX_MEMORY_MB=1024
LOOM_SANDBOX_ROW_LIMIT=10000
LOOM_LAMBDA_FUNCTION_NAME=loom-executor

# --- Models ---
LOOM_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOOM_RERANKER_MODEL=BAAI/bge-reranker-base
LOOM_EMBEDDING_BACKEND=hf              # hf | hashing (offline test fallback)

# --- Tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
